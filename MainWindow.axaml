<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MdViewer.MainWindow"
        Title="MdViewer" Icon="avares://MdViewer/Assets/app.ico" Width="1200" Height="800" MinWidth="600" MinHeight="400">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Background="{DynamicResource BarBg}" Padding="8,6">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Name="BackButton" Content="◀" ToolTip.Tip="Atrás (Alt+←)" />
        <Button Name="ForwardButton" Content="▶" ToolTip.Tip="Adelante (Alt+→)" />
        <ComboBox Name="ProjectCombo" Width="240" PlaceholderText="Seleccioná un proyecto" />
        <Button Name="OpenButton" Content="📂 Agregar carpeta…" />
        <Button Name="RemoveButton" Content="Quitar proyecto" />
        <Button Name="SearchButton" Content="🔍 Buscar" ToolTip.Tip="Ctrl+F" />
        <Button Name="ThemeButton" Content="🌓 Tema" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" Name="MainGrid" ColumnDefinitions="260,3,*">
      <Border Grid.Column="0" Background="{DynamicResource SideBarBg}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="EXPLORADOR" FontSize="11" Opacity="0.75" Margin="20,10,8,6" />
          <TreeView Name="Tree" Background="Transparent" />
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" Width="3" />
      <Grid Grid.Column="2" RowDefinitions="Auto,*" Background="{DynamicResource EditorBg}">
        <Border Name="SearchBar" Grid.Row="0" IsVisible="False" Padding="8,6"
                Background="{DynamicResource SideBarBg}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBox Name="SearchBox" Width="280" Watermark="Buscar en el documento…" />
            <Button Name="PrevMatch" Content="↑" />
            <Button Name="NextMatch" Content="↓" />
            <TextBlock Name="MatchCount" VerticalAlignment="Center" />
            <Button Name="CloseSearch" Content="✕" />
          </StackPanel>
        </Border>
        <ScrollViewer Name="Scroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
          <Border Name="Host" Margin="26,16,26,48" MaxWidth="1000" HorizontalAlignment="Stretch" />
        </ScrollViewer>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource StatusBg}" Padding="10,3">
      <TextBlock Name="Status" Foreground="{DynamicResource StatusFg}" FontSize="12" />
    </Border>
  </Grid>
</Window>
